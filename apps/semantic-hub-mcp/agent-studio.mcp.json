{
  "mcpServers": {
    "semantic-hub": {
      "command": "uvx",
      "args": [
        "--refresh",
        "--from",
        "git+https://github.com/FerdinandZhong/semantic-hub.git@main#subdirectory=apps/semantic-hub-mcp",
        "semantic-hub-mcp"
      ],
      "env": {
        "SEMANTIC_HUB_URL": "https://<semantic-hub-application-host>",
        "CDSW_APIV2_KEY": "<your-cai-api-v2-key>"
      }
    }
  }
}
