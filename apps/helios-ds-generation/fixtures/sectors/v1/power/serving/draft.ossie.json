  "metrics": [
    {
      "name": "measured_import_kwh",
      "description": "Measured imported energy, kWh. Only VALID, non-estimated readings; dates use Asia/Singapore.",
      "expression": {
        "dialects": [
          {
            "dialect": "ANSI_SQL",
            "expression": "SUM(CASE WHEN meter_readings.quality_status = 'VALID' AND meter_readings.is_estimated = 'false' THEN meter_readings.import_kwh ELSE 0 END)"
          }
        ]
      }
    }
